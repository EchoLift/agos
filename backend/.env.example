NODE_ENV=development
API_PORT=4000
WEBSOCKET_PORT=4001
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://agency_os:agency_os@localhost:5432/agency_os
DIRECT_URL=postgresql://agency_os:agency_os@localhost:5432/agency_os
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://agency_os:agency_os@localhost:5672
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
FIELD_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
FIELD_LOOKUP_SECRET=replace-with-lookup-secret
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id

# Email Delivery (Resend Primary, SendGrid Fallback)
RESEND_API_KEY=
RESEND_FROM_EMAIL=AGOS <notifications@calcie.fun>

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=notifications@calcie.fun
SENDGRID_FROM_NAME=AGOS

# Development-only role testing. Keep disabled outside local development.
DEV_ROLE_TESTING_OVERRIDE_ENABLED=false
DEV_ROLE_TESTING_USER_IDS=
DEV_ROLE_TESTING_AUTH_USER_IDS=
